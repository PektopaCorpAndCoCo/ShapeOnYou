<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Guideline à 85% de la hauteur (pour caler le bas du bouton) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_h85"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />

    <!-- Triangle bleu, 60% de la largeur, ratio 1:1, collé tout en haut -->
    <ImageView
        android:id="@+id/ivTriangle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_triangle"
        android:scaleType="centerCrop"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Conteneur du formulaire, directement sous le triangle -->
    <LinearLayout
        android:id="@+id/form_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/form_border"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivTriangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="0dp">

        <!-- Titre du formulaire -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="center" />

        <!-- Username + trait -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="➔ Username"
            android:background="@null"
            android:paddingBottom="4dp"
            android:layout_marginTop="16dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000" />

        <!-- Email + trait -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="➔ Email"
            android:inputType="textEmailAddress"
            android:background="@null"
            android:paddingBottom="4dp"
            android:layout_marginTop="16dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000" />

        <!-- Password + trait -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="➔ Password"
            android:inputType="textPassword"
            android:background="@null"
            android:paddingBottom="4dp"
            android:layout_marginTop="16dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000" />

        <!-- Confirm password + trait -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="➔ Confirm password"
            android:inputType="textPassword"
            android:background="@null"
            android:paddingBottom="4dp"
            android:layout_marginTop="16dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000" />
    </LinearLayout>

    <!-- Bouton Sign Up, calé entre le bas du formulaire et la guideline_h85 -->
    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Sign Up"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/btn_blue"
        app:layout_constraintTop_toBottomOf="@id/form_container"
        app:layout_constraintBottom_toTopOf="@id/guideline_h85"
        app:layout_constraintStart_toStartOf="@id/form_container"
        app:layout_constraintEnd_toEndOf="@id/form_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
