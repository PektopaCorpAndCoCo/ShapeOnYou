<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quest3Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_gradient">

    <!-- Question -->
    <TextView
        android:id="@+id/tvQuestion3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Combien de fois par semaine souhaitez-vous vous entraîner ?"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Option 1 à 2 fois -->
    <Button
        android:id="@+id/btnOptionOneToTwo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="1 à 2 fois"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:background="@drawable/edittext_background"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuestion3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Option 3 à 4 fois -->
    <Button
        android:id="@+id/btnOptionThreeToFour"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="3 à 4 fois"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:background="@drawable/edittext_background"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnOptionOneToTwo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Option 5 fois ou plus -->
    <Button
        android:id="@+id/btnOptionFivePlus"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="5 fois ou plus"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:background="@drawable/edittext_background"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnOptionThreeToFour"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bouton Continuer -->
    <Button
        android:id="@+id/btnContinue3"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginBottom="48dp"
        android:text="Continuer"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:background="@drawable/pill_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
