<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clSelectGoalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light">

    <!-- Container vertical qui regroupe titre, sous‐titre et boutons -->
    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Titre centré -->
        <TextView
            android:id="@+id/tvSelectGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quel est ton objectif ?"
            android:textColor="@color/black"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Sous‐titre centré, marge au‐dessous du titre -->
        <TextView
            android:id="@+id/tvSelectGoalSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choisissez l’option qui correspond à votre objectif fitness."
            android:textColor="@color/gray_dark"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Bouton “Prise de masse” stylisé, marge en haut -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPriseDeMasse"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prise de masse"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/teal_700"
            app:strokeColor="@color/teal_700"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            android:layout_marginTop="32dp" />

        <!-- Bouton “Sèche” stylisé, marge en haut -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeche"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sèche"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple_700"
            app:strokeColor="@color/purple_700"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
