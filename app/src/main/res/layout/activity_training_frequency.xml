<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/gradient_background"> <!-- ✅ Dégradé appliqué -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMBIEN DE FOIS PAR SEMAINE\nSOUHAITEZ-VOUS VOUS ENTRAÎNER ?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <RadioGroup
        android:id="@+id/rgFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbOneTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 à 2 fois"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <RadioButton
            android:id="@+id/rbThreeFour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 à 4 fois"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <RadioButton
            android:id="@+id/rbFiveMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5 fois ou plus"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />
    </RadioGroup>

    <Button
        android:id="@+id/btnFinish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONTINUER"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginTop="32dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F44336" />
</LinearLayout>
