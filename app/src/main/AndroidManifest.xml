<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.shapeonyou">

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShapeOnYou"
        tools:targetApi="31">

        <activity android:name=".BodyPartActivity" />
        <activity android:name=".ExercicePageActivity" />
        <activity android:name=".DashboardActivity" />
        <activity android:name=".NutritionAdviceActivity" />
        <activity android:name=".SelectGoalActivity" />

        <!-- Activité de lancement (Login) -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Déclaration de SignupActivity -->
        <activity
            android:name=".SignupActivity"
            android:exported="true" />

        <activity android:name=".Quest1Activity" />
        <activity android:name=".Quest2Activity"
            android:exported="true"/>
        <activity android:name=".Quest3Activity" />
        <activity android:name=".LoginActivity" />
        <activity android:name=".MainActivity" />

        <!-- Ajoutez ici d’autres activités si besoin :
        <activity android:name=".UneAutreActivity" />
         -->

    </application>
</manifest>
